# --- Base de données (stack séparée de GridBook) ---
# Éviter les caractères spéciaux (@ & % : /) dans les mots de passe
MYSQL_ROOT_PASSWORD=change_me
DB_NAME=GridBookNew
DB_USER=gridbook
DB_PASSWORD=change_me
DB_EXPOSED_PORT=3308

# Interfaces d'écoute des ports de débogage (127.0.0.1 = machine hôte uniquement)
DB_BIND=127.0.0.1
BACKEND_BIND=127.0.0.1
# Documentation interactive de l'API (/docs) : false en dehors du développement
ENABLE_API_DOCS=false

# --- Backend ---
BACKEND_PORT=8001
CORS_ORIGINS=http://localhost:5174
FRONTEND_URL=http://localhost:5174
JWT_SECRET_KEY=change_me_generate_with_python_secrets_token_urlsafe_48
# Nom de cookie distinct de GridBook : les deux sites tournent sur localhost
COOKIE_NAME=gridbook_new_session
COOKIE_SECURE=false
# Resynchronisation automatique des API (calendriers, résultats, règlement des paris)
SYNC_INTERVAL_HOURS=6

# Compte admin créé au premier démarrage (base vide)
ADMIN_EMAIL=admin@gridbook.fr
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Compte joueur de test (rôle user), créé au démarrage s'il n'existe pas. Vide = pas de compte.
TEST_USER_EMAIL=joueur@gridbook.fr
TEST_USER_USERNAME=joueur
TEST_USER_PASSWORD=change_me

# Envoi d'email (mot de passe oublié) : vide = lien affiché dans les logs du backend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Frontend ---
FRONTEND_PORT=5174
# URL de l'API vue par le navigateur, intégrée au build. "/api" = relayée par le serveur web du
# site (un seul port à exposer). Mettre une URL complète pour viser un backend séparé.
VITE_API_URL=/api
