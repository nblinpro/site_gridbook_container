# Jeton d'API Cloudflare (Zone DNS : modification) pour les certificats Let's Encrypt.
# Laisser vide tant que la machine n'est pas publiée (le site reste servi en HTTP).
CF_DNS_API_TOKEN=
# Adresse d'écoute des ports 80 et 443 (0.0.0.0 = tout le réseau, 127.0.0.1 = machine seule)
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0

# Jeton du tunnel Cloudflare (Zero Trust → Réseaux → Tunnels). Utilisé seulement avec --profile tunnel.
TUNNEL_TOKEN=
